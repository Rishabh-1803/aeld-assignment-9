#!/bin/sh

case "$1" in
    start)
        echo "Starting LDD3 modules"

        # Load misc modules
        modprobe hello
        insmod /lib/modules/$(uname -r)/extra/faulty.ko

        # Load scull
        modprobe scull || exit 1

        # Get dynamically allocated scull major number
        major=$(awk '$2=="scull" {print $1}' /proc/devices)

        if [ -z "$major" ]; then
            echo "Could not determine scull major number"
            exit 1
        fi

        # Remove any stale device nodes
        rm -f /dev/scull0 /dev/scull1 /dev/scull2 /dev/scull3
        rm -f /dev/scullpipe0 /dev/scullpipe1 /dev/scullpipe2 /dev/scullpipe3
        rm -f /dev/scullsingle /dev/sculluid /dev/scullwuid /dev/scullpriv

        # Create scull devices
        mknod /dev/scull0 c $major 0
        mknod /dev/scull1 c $major 1
        mknod /dev/scull2 c $major 2
        mknod /dev/scull3 c $major 3

        # Create scull pipe devices
        mknod /dev/scullpipe0 c $major 4
        mknod /dev/scullpipe1 c $major 5
        mknod /dev/scullpipe2 c $major 6
        mknod /dev/scullpipe3 c $major 7

        # Create scull access-control devices
        mknod /dev/scullsingle c $major 8
        mknod /dev/sculluid c $major 9
        mknod /dev/scullwuid c $major 10
        mknod /dev/scullpriv c $major 11

        chmod 0664 /dev/scull0 /dev/scull1 /dev/scull2 /dev/scull3
        chmod 0664 /dev/scullpipe0 /dev/scullpipe1 /dev/scullpipe2 /dev/scullpipe3
        chmod 0664 /dev/scullsingle /dev/sculluid /dev/scullwuid /dev/scullpriv

        echo "LDD3 modules started"
        ;;

    stop)
        echo "Stopping LDD3 modules"

        # Remove scull device nodes
        rm -f /dev/scull0 /dev/scull1 /dev/scull2 /dev/scull3
        rm -f /dev/scullpipe0 /dev/scullpipe1 /dev/scullpipe2 /dev/scullpipe3
        rm -f /dev/scullsingle /dev/sculluid /dev/scullwuid /dev/scullpriv

        # Unload modules
        rmmod faulty 2>/dev/null || true
        rmmod hello 2>/dev/null || true
        rmmod scull 2>/dev/null || true

        echo "LDD3 modules stopped"
        ;;

    restart)
        $0 stop
        $0 start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
